{
  "name": "campuscash",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @campuscash/api run dev",
    "dev:web": "npm --workspace @campuscash/web run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "db:generate": "npm --workspace @campuscash/api run db:generate",
    "db:push": "npm --workspace @campuscash/api run db:push",
    "db:seed": "npm --workspace @campuscash/api run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "rollup": "npm:@rollup/wasm-node@^4.68.8",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
